{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowdesk.local/schemas/project.schema.json",
  "title": "Flowdesk Project Manifest",
  "type": "object",
  "required": ["project_id", "project_version", "pipeline_version", "samples"],
  "properties": {
    "project_id": { "type": "string" },
    "project_version": { "const": "1.6.0" },
    "pipeline_version": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    },
    "advanced_groups_enabled": { "type": "boolean" },
    "sample_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/sampleGroup" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "group_strategy_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/groupStrategyBinding" }
    },
    "compensation_matrices": {
      "type": "array",
      "items": { "$ref": "#/$defs/compensationMatrix" }
    },
    "compensation_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/compensationBinding" }
    },
    "compensation_calculations": {
      "type": "array",
      "items": { "$ref": "#/$defs/compensationCalculation" }
    },
    "derived_parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/derivedParameter" }
    },
    "transforms": {
      "type": "array",
      "items": { "$ref": "#/$defs/transform" }
    },
    "gating_strategies": { "type": "array", "items": { "type": "object" } },
    "gating_strategies_data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gatingStrategy" }
    },
    "default_gating_strategy_id": { "type": "string" },
    "default_compensation_matrix_id": { "type": ["string", "null"] },
    "export_settings": { "type": "array", "items": { "type": "object" } },
    "execution_profiles": { "type": "array", "items": { "type": "object" } },
    "last_execution_report_path": { "type": ["string", "null"] },
    "sample_path_resolution_policy": { "type": "string" },
    "software": { "type": "object" },
    "plot_display_settings": { "$ref": "#/$defs/plotDisplaySettings" },
    "plot_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/plotView" }
    },
    "comparison_set_definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparisonSet" }
    },
    "comparison_role_colors": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlay" }
    },
    "layout_plot_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutPlotReference" }
    },
    "template_source_roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateSourceRole" }
    },
    "statistics": {
      "type": "array",
      "items": { "$ref": "#/$defs/statistic" }
    },
    "migration_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "stage", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "stage": { "const": "migration" },
          "message": { "type": "string", "minLength": 1 },
          "parameter_id": { "type": "string" },
          "transform_id": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "overlaySource": {
      "type": "object",
      "required": ["source_id", "display_name", "x_parameter_id", "order"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "sample_id": { "type": ["string", "null"] },
        "template_source_role": { "type": ["string", "null"] },
        "population_id": { "type": ["string", "null"] },
        "template_population_path": { "type": ["string", "null"] },
        "display_name": { "type": "string", "minLength": 1 },
        "x_parameter_id": { "type": "string", "minLength": 1 },
        "y_parameter_id": { "type": ["string", "null"] },
        "x_transform_id": { "type": ["string", "null"] },
        "y_transform_id": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "x_unit": { "type": ["string", "null"] },
        "y_unit": { "type": ["string", "null"] },
        "visible": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "analysis_revision": { "type": ["string", "null"] }
      },
      "anyOf": [
        { "required": ["sample_id"] },
        { "required": ["template_source_role"] }
      ],
      "additionalProperties": true
    },
    "plotView": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "overlay_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlaySource" }
        },
        "presentation": { "type": ["object", "null"] },
        "rendering_downsample": {
          "type": "object",
          "properties": {
            "max_points": { "type": "integer", "minimum": 0, "default": 20000 }
          },
          "additionalProperties": true
        },
        "manual_overlay_sample_ids": {
          "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "manual_overlay_colors": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "overlay_mode": { "enum": ["manual_only", "manual_plus_comparison", "comparison_only"] },
        "population_display_colors": {
          "type": "array", "items": { "$ref": "#/$defs/populationDisplay" }
        }
      },
      "additionalProperties": true
    },
    "overlay": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlaySource" }
        },
        "presentation": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "layoutPlotReference": {
      "type": "object",
      "required": ["id", "plot_view_id", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "plot_view_id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["reference", "copy"] },
        "scene_bounds": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "caption": { "type": ["string", "null"] },
        "copied_from": { "type": "string" },
        "presentation_overrides": { "type": "object" }
      },
      "additionalProperties": true
    },
    "templateSourceRole": {
      "type": "object",
      "required": ["source_role", "population_path", "parameter_role"],
      "properties": {
        "source_role": { "type": "string", "minLength": 1 },
        "population_path": { "type": "string", "minLength": 1 },
        "parameter_role": { "type": "string", "minLength": 1 },
        "transform_role": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "comparisonSet": {
      "type": "object",
      "required": ["id", "name", "members"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/$defs/comparisonMember" }
        },
        "role_colors": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      },
      "additionalProperties": true
    },
    "comparisonMember": {
      "type": "object",
      "required": ["sample_id", "role"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["reference", "target", "positive_control", "negative_control", "control"] }
      },
      "additionalProperties": true
    },
    "populationDisplay": {
      "type": "object",
      "required": ["population_id"],
      "properties": {
        "population_id": { "type": "string", "minLength": 1 },
        "color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
        "gate_outline_color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
        "use_population_color_for_outline": { "type": "boolean" },
        "z_order": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sampleGroup": {
      "type": "object",
      "required": ["id", "name", "role", "sample_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["all_samples", "compensation_controls", "panel", "acquisition", "qc", "user"]
        },
        "color": { "type": ["string", "null"] },
        "sample_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "membership_rule": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": ["sample_id", "keyword", "value", "source"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "keyword": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "integer", "boolean", "null"] },
        "source": { "enum": ["fcs", "workspace", "imported"] }
      },
      "additionalProperties": true
    },
    "groupStrategyBinding": {
      "type": "object",
      "required": ["id", "group_id", "gating_strategy_id", "statistic_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string", "minLength": 1 },
        "gating_strategy_id": { "type": "string", "minLength": 1 },
        "statistic_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "required": ["id", "transform_type", "parameter", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "transform_type": {
          "enum": [
            "linear",
            "log",
            "asinh",
            "logicle",
            "legacy_logicle_approximation"
          ]
        },
        "parameter": { "type": "string", "minLength": 1 },
        "role": { "const": "analysis" },
        "settings": { "type": "object" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "transform_type": { "const": "logicle" } },
            "required": ["transform_type"]
          },
          "then": {
            "required": ["settings"],
            "properties": {
              "settings": {
                "type": "object",
                "required": ["T", "W", "M", "A", "implementation_version"],
                "properties": {
                  "T": { "type": "number", "exclusiveMinimum": 0 },
                  "W": { "type": "number", "minimum": 0 },
                  "M": { "type": "number", "exclusiveMinimum": 0 },
                  "A": { "type": "number" },
                  "implementation_version": {
                    "const": "logicle-gml2-moore-parks-2012-v1"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "gatingStrategy": {
      "type": "object",
      "required": ["id", "gates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "root_population_id": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": ["id", "gate_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "gate_type": { "enum": ["rectangle", "polygon", "range", "ellipse", "boolean"] },
        "parent_population_id": { "type": ["string", "null"] },
        "x_parameter": { "type": ["string", "null"] },
        "y_parameter": { "type": ["string", "null"] },
        "x_scale": { "enum": ["linear", "log10", "asinh"] },
        "y_scale": { "enum": ["linear", "log10", "asinh"] },
        "x_transform_id": { "type": ["string", "null"] },
        "y_transform_id": { "type": ["string", "null"] },
        "transform_id": { "type": ["string", "null"] },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "thresholds": { "type": "object" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plotDisplaySettings": {
      "type": "object",
      "properties": {
        "selected_sample_id": { "type": ["string", "null"] },
        "x_channel": { "type": "string" },
        "y_channel": { "type": "string" },
        "x_scale": { "enum": ["linear", "log10", "asinh"] },
        "y_scale": { "enum": ["linear", "log10", "asinh"] },
        "marginal_enabled": { "type": "boolean" },
        "display_max_points": { "type": "integer", "minimum": 0, "default": 20000 }
      },
      "additionalProperties": true
    },
    "derivedParameter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "expression",
        "output_channel_id",
        "unit",
        "source_stage",
        "input_parameters",
        "invalid_value_policy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "source_stage": { "enum": ["raw", "compensated", "transformed"] },
        "legacy_source_stage_policy": { "const": "reject" },
        "input_parameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "output_channel_id": { "type": "string", "minLength": 1 },
        "output_label": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "invalid_value_policy": {
          "enum": [
            "fail_run",
            "fail_sample",
            "emit_nan_with_warning"
          ]
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_stage": { "const": "transformed" } },
            "required": ["source_stage"]
          },
          "then": { "required": ["legacy_source_stage_policy"] },
          "else": { "not": { "required": ["legacy_source_stage_policy"] } }
        }
      ],
      "additionalProperties": true
    },
    "sample": {
      "type": "object",
      "required": ["id", "channels"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fileFingerprint" },
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel" }
        }
      },
      "additionalProperties": true
    },
    "fileFingerprint": {
      "type": "object",
      "required": ["size", "mtime_ns", "hash_algorithm", "hash_value"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "hash_algorithm": { "type": "string", "minLength": 1 },
        "hash_value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "channel": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": ["string", "null"] },
        "detector": { "type": ["string", "null"] },
        "stain": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "fcs_parameter_index": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "compensationMatrix": {
      "type": "object",
      "required": ["id", "name", "source", "channels", "matrix"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": {
          "enum": ["fcs_metadata_spillover", "user_defined", "imported", "calculated"]
        },
        "channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "created_by": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "provenance": { "$ref": "#/$defs/compensationProvenance" }
      },
      "additionalProperties": true
    },
    "compensationProvenance": {
      "type": "object",
      "properties": {
        "source_sample_id": { "type": ["string", "null"] },
        "source_metadata_key": { "type": ["string", "null"] },
        "control_sample_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "control_population_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "algorithm": { "type": ["string", "null"] },
        "algorithm_version": { "type": ["string", "null"] },
        "software_version": { "type": ["string", "null"] },
        "derived_from_matrix_id": { "type": ["string", "null"] },
        "manual_edits": {
          "type": "array",
          "items": { "$ref": "#/$defs/compensationManualEdit" }
        }
      },
      "additionalProperties": true
    },
    "compensationManualEdit": {
      "type": "object",
      "required": ["row_channel_id", "column_channel_id", "old_value", "new_value"],
      "properties": {
        "row_channel_id": { "type": "string", "minLength": 1 },
        "column_channel_id": { "type": "string", "minLength": 1 },
        "old_value": { "type": "number" },
        "new_value": { "type": "number" },
        "edited_at": { "type": ["string", "null"] },
        "edited_by": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "compensationBinding": {
      "type": "object",
      "required": ["id", "matrix_id", "scope", "target_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "matrix_id": { "type": "string", "minLength": 1 },
        "scope": {
          "enum": ["sample", "group", "execution_profile"]
        },
        "target_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": ["string", "null"] },
        "created_by": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "compensationCalculationControl": {
      "type": "object",
      "required": ["sample_id", "detector_channel_id", "positive_population_id",
                   "negative_population_id"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "detector_channel_id": { "type": "string", "minLength": 1 },
        "positive_population_id": { "type": "string", "minLength": 1 },
        "negative_population_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "compensationCalculation": {
      "type": "object",
      "required": ["id", "name", "controls"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/compensationCalculationControl" },
          "minItems": 1
        },
        "regression_method": {
          "type": "string",
          "enum": ["linear", "median"],
          "default": "linear"
        },
        "outlier_policy": {
          "type": "string",
          "enum": ["iqr", "zscore", "none"],
          "default": "iqr"
        },
        "minimum_positive_events": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "minimum_negative_events": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        },
        "created_by": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "statistic": {
      "type": "object",
      "required": ["id", "name", "population_id", "metric", "source_stage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "population_id": { "type": "string", "minLength": 1 },
        "parameter_id": { "type": ["string", "null"] },
        "metric": {
          "enum": [
            "count",
            "frequency_of_parent",
            "frequency_of_total",
            "mean",
            "median",
            "geometric_mean",
            "stddev",
            "cv",
            "mad",
            "percentile"
          ]
        },
        "source_stage": {
          "enum": ["raw", "compensated", "transformed"]
        },
        "settings": { "type": "object" },
        "format": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

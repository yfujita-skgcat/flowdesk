{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowdesk.local/schemas/project.schema.json",
  "title": "Flowdesk Project Manifest",
  "type": "object",
  "required": ["project_id", "project_version", "pipeline_version", "samples"],
  "properties": {
    "project_id": { "type": "string" },
    "project_version": { "const": "1.5.0" },
    "pipeline_version": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    },
    "compensation_matrices": { "type": "array", "items": { "type": "object" } },
    "derived_parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/derivedParameter" }
    },
    "transforms": {
      "type": "array",
      "items": { "$ref": "#/$defs/transform" }
    },
    "gating_strategies": { "type": "array", "items": { "type": "object" } },
    "gating_strategies_data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gatingStrategy" }
    },
    "default_gating_strategy_id": { "type": "string" },
    "default_compensation_matrix_id": { "type": ["string", "null"] },
    "export_settings": { "type": "array", "items": { "type": "object" } },
    "execution_profiles": { "type": "array", "items": { "type": "object" } },
    "last_execution_report_path": { "type": ["string", "null"] },
    "sample_path_resolution_policy": { "type": "string" },
    "software": { "type": "object" },
    "plot_display_settings": { "$ref": "#/$defs/plotDisplaySettings" },
    "migration_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "stage", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "stage": { "const": "migration" },
          "message": { "type": "string", "minLength": 1 },
          "parameter_id": { "type": "string" },
          "transform_id": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "required": ["id", "transform_type", "parameter", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "transform_type": {
          "enum": [
            "linear",
            "log",
            "asinh",
            "logicle",
            "legacy_logicle_approximation"
          ]
        },
        "parameter": { "type": "string", "minLength": 1 },
        "role": { "const": "analysis" },
        "settings": { "type": "object" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "transform_type": { "const": "logicle" } },
            "required": ["transform_type"]
          },
          "then": {
            "required": ["settings"],
            "properties": {
              "settings": {
                "type": "object",
                "required": ["T", "W", "M", "A", "implementation_version"],
                "properties": {
                  "T": { "type": "number", "exclusiveMinimum": 0 },
                  "W": { "type": "number", "minimum": 0 },
                  "M": { "type": "number", "exclusiveMinimum": 0 },
                  "A": { "type": "number" },
                  "implementation_version": {
                    "const": "logicle-gml2-moore-parks-2012-v1"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "gatingStrategy": {
      "type": "object",
      "required": ["id", "gates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "root_population_id": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": ["id", "gate_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "gate_type": { "enum": ["rectangle", "polygon", "range", "boolean"] },
        "parent_population_id": { "type": ["string", "null"] },
        "x_parameter": { "type": ["string", "null"] },
        "y_parameter": { "type": ["string", "null"] },
        "x_scale": { "enum": ["linear", "log10", "asinh"] },
        "y_scale": { "enum": ["linear", "log10", "asinh"] },
        "x_transform_id": { "type": ["string", "null"] },
        "y_transform_id": { "type": ["string", "null"] },
        "transform_id": { "type": ["string", "null"] },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "thresholds": { "type": "object" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plotDisplaySettings": {
      "type": "object",
      "properties": {
        "selected_sample_id": { "type": ["string", "null"] },
        "x_channel": { "type": "string" },
        "y_channel": { "type": "string" },
        "x_scale": { "enum": ["linear", "log10", "asinh"] },
        "y_scale": { "enum": ["linear", "log10", "asinh"] },
        "marginal_enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "derivedParameter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "expression",
        "output_channel_id",
        "unit",
        "source_stage",
        "input_parameters",
        "invalid_value_policy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "source_stage": { "enum": ["raw", "compensated", "transformed"] },
        "legacy_source_stage_policy": { "const": "reject" },
        "input_parameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "output_channel_id": { "type": "string", "minLength": 1 },
        "output_label": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "invalid_value_policy": {
          "enum": [
            "fail_run",
            "fail_sample",
            "emit_nan_with_warning"
          ]
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_stage": { "const": "transformed" } },
            "required": ["source_stage"]
          },
          "then": { "required": ["legacy_source_stage_policy"] },
          "else": { "not": { "required": ["legacy_source_stage_policy"] } }
        }
      ],
      "additionalProperties": true
    },
    "sample": {
      "type": "object",
      "required": ["id", "channels"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fileFingerprint" },
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel" }
        }
      },
      "additionalProperties": true
    },
    "fileFingerprint": {
      "type": "object",
      "required": ["size", "mtime_ns", "hash_algorithm", "hash_value"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "hash_algorithm": { "type": "string", "minLength": 1 },
        "hash_value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "channel": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": ["string", "null"] },
        "detector": { "type": ["string", "null"] },
        "stain": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "fcs_parameter_index": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
